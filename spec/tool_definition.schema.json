{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dymium.io/schema/tool_definition.schema.json",
  "title": "ToolDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "tool_type"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "parameters": { "type": "object" },
    "source": {
      "type": "string",
      "description": "Tool origin (e.g., mcp, builtin, internal, external)."
    },
    "tool_type": {
      "type": "string",
      "enum": ["direct", "delegated"],
      "description": "Tool execution mode. direct resolves placeholders at execution according to input_mode; delegated receives placeholders and manages nested tool resolution itself."
    },
    "input_mode": {
      "type": "string",
      "enum": ["resolve", "protect"],
      "description": "Direct-tool input handling. resolve materializes originals at execution; protect keeps placeholders in direct tool args. Ignored for delegated tools."
    },
    "delegated_transport": {
      "description": "Delegated remote transport. If set on a local delegated tool with no handler, runtime performs an automatic delegated handoff and propagates Dymium context.",
      "oneOf": [
        {
          "type": "string",
          "description": "Delegated invoke URL."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["http"] },
            "url": { "type": "string" },
            "base_url": { "type": "string" },
            "path": { "type": "string" },
            "method": { "type": "string", "enum": ["POST"] },
            "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "prompt_arg": { "type": "string" },
            "messages_arg": { "type": "string" },
            "include_args": { "type": "boolean" },
            "recursion_limit": { "type": "integer", "minimum": 1 },
            "security_context": { "type": "string", "enum": ["auto", "off"] }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool_type": { "const": "direct" }
        },
        "required": ["tool_type"]
      },
      "then": {
        "required": ["input_mode"]
      }
    }
  ]
}
